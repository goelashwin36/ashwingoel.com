{
	"compilerOptions": {
		"outDir": "build/dist",
		"module": "commonjs",
		"target": "es6",
		"lib": ["es6", "dom"],
		"sourceMap": false,
		"allowJs": true,
		"jsx": "react-jsx",
		"moduleResolution": "node",
		"rootDir": "src",
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": false,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noUnusedLocals": true
	},
	"exclude": [
		"node_modules",
		"build",
		"scripts",
		"acceptance-tests",
		"webpack",
		"jest",
		"src/setupTests.ts",
		"src/reportWebVitals.ts"
	],
	"types": ["typePatches"]
}
